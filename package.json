{
  "name": "SharpReminder",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint src __tests__",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.ts\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.ts\" \"*.js\"",
    "test": "jest",
    "test:android": "cd android && ./gradlew :app:testDebugUnitTest",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test:ios": "cd ios && xcodebuild test -workspace SharpReminder.xcworkspace -scheme SharpReminder -destination \"platform=iOS Simulator,name=iPhone 17 Pro\" -only-testing:SharpReminderTests",
    "test:native": "npm run test:android && npm run test:ios"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^18.1.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native/new-app-screen": "0.86.2",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-localize": "^3.7.0",
    "react-native-maps": "^1.29.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.27.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "SharpReminderSpecs",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.sharpreminder.triggers"
    }
  }
}
